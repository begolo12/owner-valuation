{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "web-build",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
